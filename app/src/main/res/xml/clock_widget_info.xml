<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.taro.inkwidgets.ClockConfigActivity"
    android:description="@string/clock_widget_description"
    android:initialLayout="@layout/widget_clock"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:previewImage="@drawable/preview_clock"
    android:previewLayout="@layout/widget_clock_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
