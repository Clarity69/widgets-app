    <!-- Manual add bottom sheet -->
    <string name="manual_title">Tambah widget secara manual</string>
    <string name="manual_intro">Launcher ini tidak mendukung penambahan widget langsung dari aplikasi (sering terjadi di MIUI). Ikuti langkah berikut:</string>
    <string name="manual_step_1">Kembali ke layar utama.</string>
    <string name="manual_step_2">Tekan lama area kosong (atau cubit layar).</string>
    <string name="manual_step_3">Ketuk \"Widget\", lalu cari \"InkWidgets\".</string>
    <string name="manual_step_4">Tekan lama \"%1$s\", lalu seret ke layar utama.</string>
    <string name="manual_step_5">Tekan lama widget untuk mengubah ukurannya.</string>
