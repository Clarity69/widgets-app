<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole bar is a bitmap from SearchRenderer. On top sit transparent click areas whose
  widths match SearchRenderer.ICON_ZONE_DP (48dp) and END_MARGIN_DP (4dp).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <ImageView
        android:id="@+id/search_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/preview_search" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <FrameLayout
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/search_content_description" />

        <FrameLayout
            android:id="@+id/mic_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@drawable/icon_ripple"
            android:contentDescription="@string/mic_content_description" />

        <FrameLayout
            android:id="@+id/lens_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@drawable/icon_ripple"
            android:contentDescription="@string/lens_content_description" />

    </LinearLayout>

</FrameLayout>
